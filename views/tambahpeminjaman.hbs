
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Peminjaman</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-gray-100">

    <div class="flex justify-center items-center min-h-screen">

        <div class="bg-white p-6 rounded-lg shadow-md w-80">

            <h1 class="text-xl font-bold text-center mb-5">
                TAMBAH PEMINJAMAN
            </h1>

            <form action="/tambahpeminjaman" method="POST"
                  class="flex flex-col gap-3">

                <label>Nama Siswa:</label>

                <select name="id_siswa" required
                        class="border p-2 rounded">

                    <option value="">Pilih Siswa</option>

                    {{#each siswa}}
                    <option value="{{this.id}}">
                        {{this.namasiswa}} - {{this.kelas}}
                    </option>
                    {{/each}}

                </select>

                <label>Judul Buku:</label>

                <select name="id_buku" required
                        class="border p-2 rounded">

                    <option value="">Pilih Buku</option>

                    {{#each buku}}
                    <option value="{{this.id}}">
                        {{this.judulbuku}}
                    </option>
                    {{/each}}

                </select>

                <label>Tanggal Pinjam:</label>
                <input type="date" name="tanggalpinjam" required
                       class="border p-2 rounded">

                <label>Tanggal Kembali:</label>
                <input type="date" name="tanggalkembali"
                       class="border p-2 rounded">

                <button type="submit"
                        class="bg-blue-500 text-white p-2 rounded hover:bg-blue-600">
                    Simpan
                </button>

            </form>

            <a href="/peminjaman"
               class="block text-center text-blue-500 mt-4">
                Kembali
            </a>

        </div>

    </div>

</body>
</html>
