
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Siswa</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-gray-100">

    <div class="p-10">

        <h1 class="text-2xl font-bold mb-5">
            Data Siswa
        </h1>

        <a href="/tambahsiswa"
           class="inline-block bg-blue-500 text-white p-2 rounded mb-5">
            Tambah Siswa
        </a>

        <table class="bg-white w-full border">

            <thead>
                <tr class="bg-blue-500 text-white">
                    <th class="p-3 border">ID</th>
                    <th class="p-3 border">NIS</th>
                    <th class="p-3 border">Nama Siswa</th>
                    <th class="p-3 border">Kelas</th>
                    <th class="p-3 border">Jurusan</th>
                    <th class="p-3 border">Alamat</th>
                    <th class="p-3 border">Aksi</th>
                </tr>
            </thead>

            <tbody>

                {{#each siswa}}
                <tr>
                    <td class="p-3 border text-center">
                        {{this.id}}
                    </td>

                    <td class="p-3 border text-center">
                        {{this.nis}}
                    </td>

                    <td class="p-3 border text-center">
                        {{this.namasiswa}}
                    </td>

                    <td class="p-3 border text-center">
                        {{this.kelas}}
                    </td>

                    <td class="p-3 border text-center">
                        {{this.jurusan}}
                    </td>

                    <td class="p-3 border text-center">
                        {{this.alamat}}
                    </td>

                    <td class="p-3 border text-center">

                        <a href="/editsiswa/{{this.id}}"
                           class="bg-blue-500 text-white p-2 rounded">
                            Edit
                        </a>

                        <form action="/hapussiswa/{{this.id}}"
                              method="POST"
                              class="inline">

                            <button type="submit"
                                    onclick="return confirm('Yakin ingin menghapus siswa ini?')"
                                    class="bg-red-500 text-white p-2 rounded">
                                Hapus
                            </button>

                        </form>

                    </td>
                </tr>

                {{else}}
                <tr>
                    <td colspan="7" class="p-3 text-center">
                        Belum ada data siswa
                    </td>
                </tr>
                {{/each}}

            </tbody>

        </table>

        <a href="/peminjaman"
           class="inline-block bg-blue-500 text-white p-2 rounded mt-5">
            Data Peminjaman
        </a>

        <a href="/logout"
           class="inline-block bg-red-500 text-white p-2 rounded mt-5">
            Logout
        </a>

    </div>

</body>
</html>
