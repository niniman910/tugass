
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Buku</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-gray-100">

    <div class="p-10">

        <h1 class="text-2xl font-bold mb-5">
            Data Buku
        </h1>

        <a href="/tambahbuku"
           class="inline-block bg-blue-500 text-white p-2 rounded mb-5">
            Tambah Buku
        </a>

        <table class="bg-white w-full border">

            <thead>
                <tr class="bg-blue-500 text-white">
                    <th class="p-3 border">ID</th>
                    <th class="p-3 border">Judul Buku</th>
                    <th class="p-3 border">Penulis</th>
                    <th class="p-3 border">Kategori</th>
                    <th class="p-3 border">Tahun Terbit</th>
                    <th class="p-3 border">ISBN</th>
                    <th class="p-3 border">Aksi</th>
                </tr>
            </thead>

            <tbody>

                {{#each buku}}
                <tr>
                    <td class="p-3 border text-center">
                        {{this.id}}
                    </td>

                    <td class="p-3 border text-center">
                        {{this.judulbuku}}
                    </td>

                    <td class="p-3 border text-center">
                        {{this.penulis}}
                    </td>

                    <td class="p-3 border text-center">
                        {{this.kategori}}
                    </td>

                    <td class="p-3 border text-center">
                        {{this.tahunterbit}}
                    </td>

                    <td class="p-3 border text-center">
                        {{this.isbn}}
                    </td>

                    
                    <td class="p-3 border text-center">

                    <a href="/editbuku/{{this.id}}"
                    class="bg-blue-500 text-white p-2 rounded">Edit</a>

                    <form action="/hapusbuku/{{this.id}}"
                    method="POST"
                    class="inline">

                    <button type="submit"
                    onclick="return confirm('Yakin ingin menghapus buku ini?')"
                    class="bg-red-500 text-white p-2 rounded">Hapus
                    </button>
                     </form> 
                     </td>

                </tr>

                {{else}}
                <tr>
                    <td colspan="6" class="p-3 text-center">
                        Belum ada data buku
                    </td>
                </tr>
                {{/each}}

            </tbody>

        </table>

        <a href="/logout"
           class="inline-block bg-red-500 text-white p-2 rounded mt-5">
            Logout
        </a>

    </div>

</body>
</html>