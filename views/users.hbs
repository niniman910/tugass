
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Users</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-100">

    <div class="p-10">

        <h1 class="text-2xl font-bold mb-5">
            Daftar Users
        </h1>

        <table class="bg-white w-full border">

            <thead>
                <tr class="bg-blue-500 text-white">
                    <th class="p-3 border">ID</th>
                    <th class="p-3 border">Username</th>
                    <th class="p-3 border">Aksi</th>
                </tr>
            </thead>

            <tbody>
                {{#each users}}
                <tr>
                    <td class="p-3 border text-center">
                        {{this.id}}
                    </td>

                    <td class="p-3 border text-center">
                        {{this.username}}
                    </td>

                    <td class="p-3 border text-center">

                        <a href="/editusers/{{this.id}}"
                           class="bg-blue-500 text-white p-2 rounded">
                            Edit
                        </a>

                        <form action="/hapususers/{{this.id}}"
                              method="POST"
                              class="inline">

                            <button type="submit"
                                class="bg-red-500 text-white p-2 rounded mr-0.5">
                                Hapus
                            </button>

                        </form>

                    </td>
                </tr>

                {{else}}
                <tr>
                    <td colspan="3" class="p-3 text-center">
                        Belum ada users
                    </td>
                </tr>
                {{/each}}
            </tbody>

        </table>

        <a href="/logout"
            class="inline-block bg-red-500 text-white p-2 rounded mt-5">
            Logout
        </a>

    </div>

</body>
</html>